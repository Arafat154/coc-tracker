<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg_midnight">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingBottom="6dp">

        <ImageView
            android:id="@+id/townhall"
            android:layout_width="40dp"
            android:layout_height="44dp"
            android:src="@drawable/art_town_hall_16"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="10dp">

            <TextView
                android:id="@+id/village"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Clash Ledger"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#F2F4F8"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/widget_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="YOUR VILLAGE, AT A GLANCE"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:textColor="#8A93A5"
                android:paddingTop="2dp"
                android:maxLines="1"
                android:ellipsize="end"/>
        </LinearLayout>

        <ImageView
            android:id="@+id/switch_village"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="12dp"
            android:src="@drawable/ic_switch_village"
            android:contentDescription="Switch to next saved village"
            android:visibility="gone"/>

        <ImageView
            android:id="@+id/refresh"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="12dp"
            android:src="@drawable/ic_refresh"
            android:background="@drawable/widget_chip_bg"
            android:contentDescription="Refresh widget"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/boost_strip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="6dp"
        android:gravity="center_vertical"
        android:background="@drawable/potion_bg">

        <ImageView
            android:id="@+id/boost_artwork"
            android:layout_width="28dp"
            android:layout_height="30dp"
            android:src="@drawable/art_builder_potion"
            android:importantForAccessibility="no"/>

        <TextView
            android:id="@+id/boost"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="3"
            android:ellipsize="end"
            android:text="Builder Potion · idle"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#D8BFF3"
            android:paddingStart="5dp"/>

        <Chronometer
            android:id="@+id/boost_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#E7D9F8"
            android:visibility="gone"/>
    </LinearLayout>

    <ListView
        android:id="@+id/rows"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="0dp"
        android:scrollbars="none"/>

    <LinearLayout
        android:id="@+id/war_strip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:padding="10dp"
        android:gravity="center_vertical"
        android:background="@drawable/widget_chip_bg"
        android:visibility="gone">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_shield"
            android:tint="#C8CFDC"
            android:importantForAccessibility="no"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="10dp">

            <TextView
                android:id="@+id/war_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:textColor="#8A93A5"/>

            <TextView
                android:id="@+id/war_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#F2F4F8"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end"
            android:paddingStart="8dp">

            <TextView
                android:id="@+id/war_when"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#8A93A5"/>

            <Chronometer
                android:id="@+id/war_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#F2F4F8"/>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="OPEN VILLAGE  ↗"
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="#8A93A5"
        android:paddingTop="8dp"/>
</LinearLayout>
