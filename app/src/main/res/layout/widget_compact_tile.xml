<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/compact_tile" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:padding="2dp">
    <ImageView android:id="@+id/compact_art" android:layout_width="44dp" android:layout_height="44dp" android:adjustViewBounds="true" android:scaleType="fitCenter" android:importantForAccessibility="no"/>
    <Chronometer android:id="@+id/compact_timer" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textSize="10sp" android:textStyle="bold" android:textColor="#A9DFB5" android:maxLines="1" android:ellipsize="end"/>
</LinearLayout>
